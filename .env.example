# 1. Google Gemini API Key for LLM (Gemini Flash)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. Hugging Face for Embeddings (Free lightweight model: BAAI/bge-small-en-v1.5 or all-MiniLM-L6-v2)
# Optional API Token if using Hugging Face Inference API (leave blank to run locally for free)
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
